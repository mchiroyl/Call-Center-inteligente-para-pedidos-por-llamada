OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBED_MODEL=text-embedding-3-small

# SQLite DB for call-center data
# CALL_CENTER_DB_PATH=/absolute/path/to/call_center.db
# RESTAURANT_DB_PATH=/absolute/path/to/call_center.db

# Restrict CORS to your frontend origins
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# Optional staff security for internal modules.
# If both are set, /admin and /api/admin/* require HTTP Basic auth.
# ADMIN_BASIC_USERNAME=admin
# ADMIN_BASIC_PASSWORD=cambia-esta-clave
#
# If set, operations endpoints and realtime dashboard actions require this key.
# OPERATIONS_API_KEY=cambia-esta-clave

# Optional demo passwords for internal login by role.
# STAFF_ADMIN_PASSWORD=admin123
# STAFF_KITCHEN_PASSWORD=cocina123
# STAFF_CASHIER_PASSWORD=caja123
# STAFF_OPERATIONS_PASSWORD=operaciones123

ASSEMBLYAI_API_KEY=your_assemblyai_api_key
ASSEMBLYAI_SPEECH_MODEL=universal-streaming-multilingual
ASSEMBLYAI_STREAMING_LANGUAGE=multi
# ASSEMBLYAI_MIN_TURN_SILENCE_MS=850
# ASSEMBLYAI_MAX_TURN_SILENCE_MS=2400
# ASSEMBLYAI_END_OF_TURN_CONFIDENCE=0.55
# ASSEMBLYAI_WS_OPEN_TIMEOUT=45

CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_LANGUAGE=es
CARTESIA_VOICE_ID=3597a26f-80ef-4bd5-8101-9699bc764917
# CARTESIA_WS_OPEN_TIMEOUT=45

# Optional Twilio integration for real inbound phone calls.
# TWILIO_AUTH_TOKEN is required for Media Streams. It validates webhook
# signatures and signs the per-call WebSocket token sent in TwiML.
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+50200000000

# Optional ngrok automation for exposing your local backend to Twilio.
# If ngrok is already in PATH, NGROK_EXE is not required.
# NGROK_EXE=C:\path\to\ngrok.exe
# NGROK_AUTHTOKEN=...
